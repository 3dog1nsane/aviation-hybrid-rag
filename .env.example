# Copy to .env and fill in your own values
# .env is git-ignored, never commit real secrets

# DeepSeek API key for LLM generation
# Get one at: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Milvus connection (defaults to local docker compose)
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Model paths (where bge-m3 and bge-reranker-v2-m3 are stored locally)
# Change to your local paths. See README for download instructions.
BGE_M3_PATH=/home/<user>/models/bge-m3
BGE_RERANKER_PATH=/home/<user>/models/bge-reranker-v2-m3
